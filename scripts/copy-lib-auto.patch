diff --git a/scripts/port_arch64.sh b/scripts/port_arch64.sh
index 0008bf7..b7e6a5d 100644
--- a/scripts/port_arch64.sh
+++ b/scripts/port_arch64.sh
@@ -10,8 +10,10 @@
 #                                   P_FS B_FS B_IMG WORK
 #
 #  ARCH64_FIX=auto|true|false   auto = jalan hanya kalau donor terdeteksi 64-bit-only
